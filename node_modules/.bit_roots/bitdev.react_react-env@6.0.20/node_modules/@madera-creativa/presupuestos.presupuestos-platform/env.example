# ─────────────────────────────────────────────────────────────
# Madera Creativa — variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el .env a un repositorio público.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (obligatorio) ──
# Cadena de conexión de MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<password>@<cluster>/<basedatos>?retryWrites=true&w=majority
MONGO_URL=

# ── Administrador inicial (obligatorio) ──
# Se crea automáticamente en la base de datos al arrancar el servicio,
# con estado "activo" y permisos de administrador.
# Sin estos valores el admin maestro no podrá iniciar sesión.
APP_USER=
APP_PASSWORD=

# ── Notificaciones Web Push (opcional) ──
# Genera un par de claves nuevo con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Asistente IA (opcional) ──
# Sin esta clave, el botón del asistente devuelve error controlado.
OPENAI_API_KEY=

# ── Servidor (opcional) ──
# Puerto del servicio backend. En la plataforma Bit se asigna automáticamente.
PORT=5001
