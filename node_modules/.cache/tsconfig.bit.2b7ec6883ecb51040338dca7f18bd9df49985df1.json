{
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node"
    ],
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "target": "es2020",
    "lib": [
      "esnext",
      "dom",
      "dom.Iterable"
    ],
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../.."
  },
  "exclude": [
    "..\\..\\presupuestos\\presupuestos-prototype/artifacts",
    "..\\..\\presupuestos\\presupuestos-prototype/public",
    "..\\..\\presupuestos\\presupuestos-prototype/dist",
    "..\\..\\presupuestos\\presupuestos-prototype/node_modules",
    "..\\..\\presupuestos\\presupuestos-prototype/package.json",
    "..\\..\\presupuestos\\presupuestos-prototype/**/*.cjs",
    "..\\..\\presupuestos\\presupuestos-prototype/./dist"
  ],
  "include": [
    "../../presupuestos/presupuestos-prototype/**/*",
    "../../presupuestos/presupuestos-prototype/**/*.json",
    "./global-types/**/*"
  ]
}