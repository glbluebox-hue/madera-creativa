{
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "target": "es2020",
    "lib": [
      "esnext",
      "dom",
      "dom.Iterable"
    ],
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../.."
  },
  "exclude": [
    "..\\..\\presupuestos\\presupuestos-platform/artifacts",
    "..\\..\\presupuestos\\presupuestos-service/artifacts",
    "..\\..\\presupuestos\\presupuestos-platform/public",
    "..\\..\\presupuestos\\presupuestos-service/public",
    "..\\..\\presupuestos\\presupuestos-platform/dist",
    "..\\..\\presupuestos\\presupuestos-service/dist",
    "..\\..\\presupuestos\\presupuestos-platform/node_modules",
    "..\\..\\presupuestos\\presupuestos-service/node_modules",
    "..\\..\\presupuestos\\presupuestos-platform/package.json",
    "..\\..\\presupuestos\\presupuestos-service/package.json",
    "..\\..\\presupuestos\\presupuestos-platform/./dist",
    "..\\..\\presupuestos\\presupuestos-service/./dist"
  ],
  "include": [
    "../../presupuestos/presupuestos-platform/**/*",
    "../../presupuestos/presupuestos-service/**/*",
    "../../presupuestos/presupuestos-platform/**/*.json",
    "../../presupuestos/presupuestos-service/**/*.json",
    "../../presupuestos/presupuestos-platform/.mocharc.js",
    "../../presupuestos/presupuestos-service/.mocharc.js",
    "../../presupuestos/presupuestos-platform/.mocharc.cjs",
    "../../presupuestos/presupuestos-service/.mocharc.cjs",
    "./global-types/**/*"
  ]
}