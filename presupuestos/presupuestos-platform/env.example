# ─────────────────────────────────────────────────────────────
# Madera Creativa — variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el .env a un repositorio público.
# ─────────────────────────────────────────────────────────────

# ── Entorno de ejecución (obligatoria en producción) ──
# NODE_ENV controla tres comportamientos de seguridad. Si se olvida
# configurar como "production" en un despliegue real, el servicio funciona
# igual pero degrada los tres en silencio, sin ningún aviso:
#
#   1. CORS: sin esta variable en "production", ALLOWED_ORIGINS es
#      obligatoria (ver más abajo) — con cualquier otro valor (o sin
#      valor), se permite cualquier origen "http://localhost:<puerto>",
#      pensado solo para desarrollo local.
#   2. Cookie del refresh token: solo lleva el atributo `Secure` (exige
#      HTTPS) cuando NODE_ENV=production. En cualquier otro caso no lo
#      lleva, para que funcione en desarrollo sobre http://localhost.
#   3. JWT_SECRET: solo es obligatoria y se valida su longitud mínima
#      cuando NODE_ENV=production. Sin esta variable, si falta o es
#      corta, el servicio arranca igual con una advertencia (o un secreto
#      temporal en memoria si falta del todo) — pensado solo para
#      desarrollo, nunca para un despliegue real.
#
# En desarrollo local, déjala vacía o sin definir.
NODE_ENV=

# ── Base de datos (obligatorio) ──
# Cadena de conexión de MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<password>@<cluster>/<basedatos>?retryWrites=true&w=majority
#
# AISLAMIENTO DEV/TEST/PRODUCCIÓN (22/08/2026) — IMPORTANTE:
# Nunca pegues aquí la cadena de conexión real de producción. Usa una base
# de datos DISTINTA para desarrollo local (como mínimo, otro nombre de base
# dentro del mismo clúster — ideal: un clúster/proyecto de Atlas aparte).
# `mongo-conexion.ts` rechaza arrancar si detecta el host de producción
# aquí sin `NODE_ENV=production` (ver `verificarAislamientoEntorno`) — así
# que si ves ese error, es justo esta variable la que hay que corregir, no
# rodearla con ALLOW_PROD_DB salvo que sepas exactamente por qué.
# Motivo: un `.env` local con el `MONGO_URL` real causó un incidente real
# (un proceso de pruebas olvidado agotó el límite de conexiones del clúster
# de producción durante 4 días sin que nadie lo notara).
MONGO_URL=

# Escape explícito, EXCEPCIONAL, para permitir conectar a MONGO_URL de
# producción sin NODE_ENV=production (p. ej. un script de mantenimiento que
# declara a propósito que va a tocar producción). Déjala vacía siempre en
# un .env de desarrollo habitual.
ALLOW_PROD_DB=

# ── Administrador inicial (obligatorio) ──
# Se crea automáticamente en la base de datos al arrancar el servicio,
# con estado "activo" y permisos de administrador.
# Sin estos valores el admin maestro no podrá iniciar sesión.
APP_USER=
APP_PASSWORD=

# ── Notificaciones Web Push (opcional) ──
# Genera un par de claves nuevo con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Núcleo de IA (opcional) ──
# Sin OPENAI_API_KEY ni Ollama corriendo, las peticiones de IA devuelven un
# error controlado (503) sin afectar al resto de la app.

# Clave de la API de OpenAI. Sin ella, ese proveedor concreto falla al
# usarse — si hay otro proveedor disponible en la cadena de esa capacidad
# (p. ej. Ollama), el sistema hace fallback automáticamente.
OPENAI_API_KEY=
# Timeout de una llamada a OpenAI, en milisegundos. Por defecto 20000 (20s).
OPENAI_TIMEOUT_MS=
# Modelo usado por "Investigación de Mercado con IA" (búsqueda web +
# extracción estructurada, ver `investigacion-mercado.ts`). Por defecto
# "gpt-4o-mini", igual que el resto de la app — solo hace falta definirlo
# si se quiere usar otro modelo para esta pieza en concreto.
OPENAI_MODEL_MERCADO=

# Proveedor de IA preferido — reordena la cadena de candidatos de cada
# capacidad para que se pruebe primero (nunca excluye al resto: si el
# preferido falla, se sigue intentando con los demás). Valores esperados:
# "openai" o "ollama". Sin definir, se prueba en el orden por defecto
# (OpenAI primero). Pensado sobre todo para desarrollo local sin coste:
# AI_PROVIDER=ollama
AI_PROVIDER=

# Ollama local — proveedor de IA sin coste para desarrollar y probar sin
# depender de una API de pago. Requiere tener Ollama instalado y corriendo
# (https://ollama.com/download) con el modelo ya descargado
# (`ollama pull qwen3:8b`) — elegido por tener soporte nativo de `tools`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Timeout de una llamada a Ollama, en milisegundos. Por defecto 60000 (60s)
# — más generoso que OpenAI porque, sin aceleración por GPU, la primera
# carga del modelo en RAM puede tardar bastante.
OLLAMA_TIMEOUT_MS=

# ── SketchUp / Trimble Connect (opcional — "Diseño 3D" por proyecto) ──
# Sin estas tres variables, esa sección de la app simplemente no se activa
# (banner "Conectar con SketchUp"), sin afectar al resto de la aplicación.
#
# TRIMBLE_CLIENT_ID / TRIMBLE_CLIENT_SECRET: credenciales de la app OAuth
# creada en developer.trimble.com (Trimble Identity) — nunca son la
# contraseña de ningún usuario, son las de la aplicación Madera Creativa.
TRIMBLE_CLIENT_ID=
TRIMBLE_CLIENT_SECRET=
# URL exacta de callback registrada en esa misma app OAuth — debe
# coincidir carácter a carácter con la que se configure en el portal de
# Trimble (p. ej. https://estudio.maderacreativa.com/api/presupuestos-service/trimble/callback).
TRIMBLE_REDIRECT_URI=
# Clave para cifrar en reposo el refresh token de cada usuario (nunca se
# guarda en claro). Cualquier cadena aleatoria larga sirve — p. ej.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIMBLE_TOKEN_ENCRYPTION_KEY=

# ── Servidor (opcional) ──
# Puerto del servicio backend. En la plataforma Bit se asigna automáticamente.
PORT=5001

# ── CORS (obligatoria en producción) ──
# Orígenes permitidos a llamar a la API, separados por comas.
# En desarrollo, si se deja vacía, se permite cualquier http://localhost:<puerto>.
# En producción es obligatoria: sin ella no se acepta ningún origen.
# Ejemplo: ALLOWED_ORIGINS=https://app.maderacreativa.com,https://www.maderacreativa.com
ALLOWED_ORIGINS=

# ── Autenticación (obligatoria en producción) ──
# Secreto para firmar los access tokens (JWT). Mínimo 32 caracteres.
# Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En desarrollo: si falta, se genera una temporal en memoria al arrancar
# (todas las sesiones se invalidan al reiniciar); si tiene menos de 32
# caracteres, se acepta pero se avisa por consola.
# En producción: el servicio no podrá firmar ni verificar tokens (falla en
# el primer intento de login) si falta o tiene menos de 32 caracteres.
JWT_SECRET=

# Días de validez del refresh token antes de tener que volver a iniciar sesión.
REFRESH_TOKEN_TTL_DIAS=30

# ── Almacenamiento de archivos — Cloudflare R2 (obligatorio en producción) ──
# Sin estas 5 variables, el servicio usa un almacenamiento en memoria que no
# persiste entre reinicios (Incremento 1.7) — válido solo para desarrollo.
# En producción, si faltan, el servicio no arranca.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública desde la que se sirven los archivos del bucket (dominio propio
# conectado al bucket, o la URL pública r2.dev si el bucket la tiene activada).
R2_PUBLIC_URL_BASE=

# ── Bucket privado de facturas (Incremento "Facturas privadas", obligatorio
# en producción) ──
# Bucket R2 SEPARADO del anterior, dedicado solo a facturas — créalo en el
# panel de Cloudflare SIN activar ningún acceso público (ni dominio propio
# ni la URL pública r2.dev): las facturas nunca deben ser accesibles con solo
# conocer su URL, se sirven siempre mediante una URL firmada temporal
# generada por el backend.
# En producción, si falta esta variable, el servicio NO ARRANCA — a
# propósito: nunca debe degradar en silencio a guardar facturas nuevas en el
# bucket público de arriba. Fuera de producción (desarrollo local) puede
# dejarse vacía mientras no se haya creado el bucket todavía; las facturas
# seguirán subiendo al bucket público de siempre sin romper nada.
R2_BUCKET_NAME_FACTURAS=

# Credenciales DEDICADAS de un token de R2 con permiso limitado
# EXCLUSIVAMENTE al bucket privado de arriba (principio de menor privilegio
# — una fuga de las credenciales generales de R2_ACCESS_KEY_ID/SECRET nunca
# debe poder tocar las facturas, y viceversa). Opcionales: si se dejan
# vacías, se reutilizan las credenciales generales de arriba (válido solo si
# ese token también tiene permiso sobre el bucket privado).
R2_ACCESS_KEY_ID_FACTURAS=
R2_SECRET_ACCESS_KEY_FACTURAS=
